# Copie para .env.local e preencha com os dados do SEU projeto Supabase.
# Guia completo em docs/ARQUITETURA.md §9.

# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor. Ignora RLS — nunca prefixe com NEXT_PUBLIC_ e nunca
# versione o valor real.
SUPABASE_SECRET_KEY=

# URL pública do portal. Usada em metadata, sitemap e no link mágico de login.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
